{"v":[[1,"কোৱা, মই আশ্ৰয় বিচাৰো উষাৰ প্ৰতিপালকৰ।","Say, \"I seek refuge in the Lord of daybreak",[["قُلْ","qul","Say","বলো"],["أَعُوذُ","aʿūdhu","I seek refuge","\"আমি আশ্রয় চাই"],["بِرَبِّ","birabbi","in (the) Lord","স্রষ্টার নিকট"],["ٱلْفَلَقِ","l-falaqi","(of) the dawn","প্রভাতের"]],"١"],[2,"তেওঁ যি সৃষ্টি কৰিছে তাৰ অনিষ্টৰ পৰা,","From the evil of that which He created",[["مِن","min","From","হতে"],["شَرِّ","sharri","(the) evil","অনিষ্ট"],["مَا","mā","(of) what","যা"],["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"]],"٢"],[3,"আৰু ৰাতিৰ অন্ধকাৰৰ অনিষ্টৰ পৰা, যেতিয়া ই গভীৰ হয়,","And from the evil of darkness when it settles",[["وَمِن","wamin","And from","এবং হতে"],["شَرِّ","sharri","(the) evil","অনিষ্ট"],["غَاسِقٍ","ghāsiqin","(of) darkness","রাতের অন্ধকারের"],["إِذَا","idhā","when","যখন"],["وَقَبَ","waqaba","it spreads","তা গভীর হয়"]],"٣"],[4,"আৰু সেইসকল নাৰীৰ অনিষ্টৰ পৰা যিসকলে গাঁঠিত ফুঁ দিয়ে,","And from the evil of the blowers in knots",[["وَمِن","wamin","And from","এবং হতে"],["شَرِّ","sharri","(the) evil","অনিষ্ট"],["ٱلنَّفَّـٰثَـٰتِ","l-nafāthāti","(of) the blowers","ফুঁকদানকারীর (রাতের) অনিষ্ট"],["فِى","fī","in","মধ্যে"],["ٱلْعُقَدِ","l-ʿuqadi","the knots","গিঁটগুলোর"]],"٤"],[5,"আৰু হিংসুকৰ অনিষ্টৰ পৰা, যেতিয়া সি হিংসা কৰে।","And from the evil of an envier when he envies.\"",[["وَمِن","wamin","And from","এবং হতে"],["شَرِّ","sharri","(the) evil","অনিষ্ট"],["حَاسِدٍ","ḥāsidin","(of) an envier","হিংসুকের"],["إِذَا","idhā","when","যখন"],["حَسَدَ","ḥasada","he envies","সে হিংসা করে\""]],"٥"]],"a":["https://download.quranicaudio.com/qdc/mishari_al_afasy/murattal/113.mp3",[[0,3470,[[1,0,360],[2,360,1280],[3,1280,2110],[4,2110,3005]]],[3470,7100,[[1,2995,3935],[2,3935,5035],[3,5035,5375],[4,5375,6590]]],[7100,12140,[[1,7065,7805],[2,7805,9205],[3,9205,10315],[4,10315,10935],[5,10935,12010]]],[12140,18150,[[1,12045,13455],[2,13455,14195],[3,14195,16485],[4,16485,16675],[5,16675,17980]]],[18150,23820,[[1,18075,18575],[2,18575,20065],[3,20065,21235],[4,21235,2182