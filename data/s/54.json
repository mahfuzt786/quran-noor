,["ضَلَـٰلٍۢ","ḍalālin","error","ভ্রান্তির"],["وَسُعُرٍ","wasuʿurin","and madness","ও বিকৃতবুদ্ধির"]],"٢٤"],[25,"আমাৰ মাজৰ পৰা এওঁৰ প্ৰতি উপদেশবাণী প্ৰেৰণ কৰা হৈছে নেকি? নহয়, সি এজন মিছলীয়া, দাম্ভিক’।","Has the message been sent down upon him from among us? Rather, he is an insolent liar.\"",[["أَءُلْقِىَ","a-ul'qiya","Has been sent","অবতীর্ণ করা হয়েছে কি"],["ٱلذِّكْرُ","l-dhik'ru","the Reminder","উপদেশ (আল্লাহর বিধান)"],["عَلَيْهِ","ʿalayhi","to him","তার উপর"],["مِنۢ","min","from","হতে"],["بَيْنِنَا","bayninā","among us","আমাদের মাঝে"],["بَلْ","bal","Nay","বরং"],["هُوَ","huwa","he","সে"],["كَذَّابٌ","kadhābun","(is) a liar","খুব মিথ্যাবাদী"],["أَشِرٌۭ","ashirun","insolent","দাম্ভিক\""]],"٢٥"],[26,"অহাকালি নিশ্চয় সিহঁতে গম পাব, কোন চৰম মিছলীয়া, দাম্ভিক।","They will know tomorrow who is the insolent liar.",[["سَيَعْلَمُونَ","sayaʿlamūna","They will know","(বলা হল) অচিরেই তারা জানবে"],["غَدًۭا","ghadan","tomorrow","আগামীকালই"],["مَّنِ","mani","who","কে"],["ٱلْكَذَّابُ","l-kadhābu","(is) the liar","খুব মিথ্যাবাদী"],["ٱلْأَشِرُ","l-ashiru","the insolent one","দাম্ভিক"]],"٢٦"],[27,"নিশ্চয় আমি সিহঁতৰ বাবে পৰীক্ষাস্বৰূপ উট পঠাই আছোঁ, এতেকে তুমি সিহঁতৰ বিষয়ে অপেক্ষা কৰা আৰু ধৈৰ্য্য ধাৰণ কৰা।","Indeed, We are sending the she-camel as trial for them, so watch them and be patient.",[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["مُرْسِلُوا۟","mur'silū","(are) sending","প্রেরণকারী"],["ٱلنَّاقَةِ","l-nāqati","the she-camel","একটি উটনী"],["فِتْنَةًۭ","fit'natan","(as) a trial","পরীক্ষা হিসেবে"],["لَّهُمْ","lahum","for them","তাদের জন্যে"],["فَٱرْتَقِبْهُمْ","fa-ir'taqib'hum","so watch them","অতএব তুমি তাদের প্রতি লক্ষ্য রাখ"],["وَٱصْطَبِرْ","wa-iṣ'ṭabir","and be patient","ও ধৈর্য ধরো"]],"٢٧"],[28,"আৰু সিহঁতক জনাই দিয়া যে, সিহঁতৰ মাজত পানী বন্টন সুনিৰ্দিষ্ট। প্ৰত্যেকেই নিজৰ পাল মতে পানীৰ ঘাটতগৈ উপস্থিত হ’ব।","And inform them that the water is shared between them, each [day of] drink attended [by turn].",[["وَنَبِّئْهُمْ","wanabbi'hum","And inform them","এবং তাদের জানিয়ে দাও"],["أَنَّ","anna","that","যে"],["ٱلْمَآءَ","l-māa","the water","পানি"],["قِسْمَةٌۢ","qis'matun","(is) to be shared","পালা করে দেওয়া হলো (হয়েছে)"],["بَيْنَهُمْ ۖ","baynahum","between them","তাদের মাঝে"],["كُلُّ","kullu","each","প্রত্যেকে"],["شِرْبٍۢ","shir'bin","drink","পান করতে"],["مُّحْتَضَرٌۭ","muḥ'taḍarun","attended","উপস্থিত হবে (পালাক্রমে)"]],"٢٨"],[29,"তাৰ পিছত সিহঁতে সিহঁতৰ সঙ্গীক মাতি আনিলে আৰু সি উটজনীক ধৰি হত্যা কৰিলে।","But they called their companion, and he dared and hamstrung [her].",[["فَنَادَوْا۟","fanādaw","But they called","তারা অতঃপর ডাকল"],["صَاحِبَهُمْ","ṣāḥibahum","their companion","তাদের এক সঙ্গীকে"],["فَتَعَاطَىٰ","fataʿāṭā","and he took","সে তখন হস্তক্ষেপ করল"],["فَعَقَرَ","faʿaqara","and hamstrung","সে অতঃপর উটনী মেরে ফেলল"]],"٢٩"],[30,"এতেকে মোৰ শাস্তি আৰু ভীতিপ্ৰদৰ্শন কেনে আছিল?","And how [severe] were My punishment and warning.",[["فَكَيْفَ","fakayfa","So how","তখন কেমন"],["كَانَ","kāna","was","ছিল"],["عَذَابِى","ʿadhābī","My punishment","আমার শাস্তি"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্কবাণী (তা লক্ষ্যকর)"]],"٣٠"],[31,"নিশ্চয় আমি সিহঁতৰ প্ৰতি পঠিয়াইছিলোঁ এটা প্ৰচণ্ড শব্দ, ফলত সিহঁত গোহালী সজা শুকান খণ্ডিত খৰিৰ দৰে হৈ গ’ল।","Indeed, We sent upon them one shriek [i.e., blast from the sky], and they became like the dry twig fragments of an [animal] pen.",[["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَرْسَلْنَا","arsalnā","[We] sent","আমরা পাঠালাম"],["عَلَيْهِمْ","ʿalayhim","upon them","তাদের উপর"],["صَيْحَةًۭ","ṣayḥatan","thunderous blast","প্রচণ্ড গর্জন"],["وَٰحِدَةًۭ","wāḥidatan","single","একটি (মাত্র)"],["فَكَانُوا۟","fakānū","and they became","ফলে তারা হয়ে গেল"],["كَهَشِيمِ","kahashīmi","like dry twig fragments","শুকনা খড়্রের মতো"],["ٱلْمُحْتَظِرِ","l-muḥ'taẓiri","(used by) a fence builder","খোঁয়াড় প্রস্তুতকারীর"]],"٣١"],[32,"আৰু নিশ্চয় আমি কোৰআনক সহজ কৰি দিছোঁ উপদেশ গ্ৰহণ কৰাৰ বাবে; এতেকে কোনোবা উপদেশ গ্ৰহণকাৰী আছেনে?","And We have certainly made the Qur’ān easy for remembrance, so is there any who will remember?",[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["يَسَّرْنَا","yassarnā","We have made easy","আমরা সহজ করেছি"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআনকে"],["لِلذِّكْرِ","lildhik'ri","for remembrance","উপদেশ গ্রহনের জন্যে"],["فَهَلْ","fahal","so is (there)","কি তবে (আছে)"],["مِن","min","any","কোনো"],["مُّدَّكِرٍۢ","muddakirin","who will receive admonition","উপদেশ গ্রহণকারী"]],"٣٢"],[33,"লূত সম্প্ৰদায়েও সতৰ্ককাৰীসকলক অস্বীকাৰ কৰিছিল।","The people of Lot denied the warning.",[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিল"],["قَوْمُ","qawmu","(the) people","জাতি"],["لُوطٍۭ","lūṭin","(of) Lut","লূতের"],["بِٱلنُّذُرِ","bil-nudhuri","the warnings","সতর্কবাণীকে"]],"٣٣"],[34,"নিশ্চয় আমি সিহঁতৰ ওপৰত শিল বহনকাৰী প্ৰচণ্ড ধুমুহা পঠিয়াইছিলোঁ, কেৱল লূত পৰিয়ালৰ বাহিৰে; তেওঁলোকক আমি উদ্ধাৰ কৰিছিলো ৰাতিৰ শেষাংশত,","Indeed, We sent upon them a storm of stones, except the family of Lot - We saved them before dawn.",[["إِنَّآ","innā","Indeed, We","আমরা নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","[We] sent","আমরা পাঠিয়েছি"],["عَلَيْهِمْ","ʿalayhim","upon them","তাদের উপর"],["حَاصِبًا","ḥāṣiban","a storm of stones","পাথরবর্ষণকারী ঝড়ো বাতাস"],["إِلَّآ","illā","except","তবে"],["ءَالَ","āla","(the) family","পরিবারকে"],["لُوطٍۢ ۖ","lūṭin","(of) Lut","লূতের (রক্ষা করি)"],["نَّجَّيْنَـٰهُم","najjaynāhum","We saved them","তাদেরকে আমরা উদ্ধার করেছিলাম"],["بِسَحَرٍۢ","bisaḥarin","by dawn","রাতের শেষে"]],"٣٤"],[35,"আমাৰ ফালৰ পৰা অনুগ্ৰহস্বৰূপ। যিয়ে কৃতজ্ঞতা প্ৰকাশ কৰে, আমি তাক এনেকৈয়ে প্ৰতিদান দিওঁ।","As favor from Us. Thus do We reward he who is grateful.",[["نِّعْمَةًۭ","niʿ'matan","(As) a favor","অনুগ্রহে"],["مِّنْ","min","from","হতে"],["عِندِنَا ۚ","ʿindinā","Us","আমাদের নিকট"],["كَذَٰلِكَ","kadhālika","Thus","এভাবেই"],["نَجْزِى","najzī","We reward","পুরস্কার দেই আমরা"],["مَن","man","(one) who","যে"],["شَكَرَ","shakara","(is) grateful","কৃতজ্ঞতা প্রকাশ করে"]],"٣٥"],[36,"আৰু নিশ্চয় লূতে সিহঁতক আমাৰ কঠিন শাস্তিৰ পৰা সতৰ্ক কৰিছিল, তথাপিও সিহঁতে সাৱধানবাণী সম্পৰ্কে সন্দেহ পোষণ কৰিছিল।","And he had already warned them of Our assault, but they disputed the warning.",[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَنذَرَهُم","andharahum","he warned them","তাদেরকে সতর্ক করেছিল সে"],["بَطْشَتَنَا","baṭshatanā","(of) Our seizure","আমাদের পাকড়াও সম্পর্কে"],["فَتَمَارَوْا۟","fatamāraw","but they disputed","তারা সন্দেহ তবে করেছিল"],["بِٱلنُّذُرِ","bil-nudhuri","the warnings","সতর্কবাণী সম্পর্কে"]],"٣٦"],[37,"আৰু নিশ্চয় সিহঁতে লূতৰ পৰা তেওঁৰ অতিথিসকলৰ পৰা অসৎ উদ্দেশ্য দাবী কৰিলে, তেতিয়া আমি সিহঁতৰ দৃষ্টি লোপ কৰি দিলোঁ (আৰু ক’লোঁ), মোৰ শাস্তি আৰু সাৱধানবাণীৰ সোৱাদ লোৱা।","And they had demanded from him his guests, but We obliterated their eyes, [saying], \"Taste My punishment and warning.\"",[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["رَٰوَدُوهُ","rāwadūhu","they demanded from him","তারা তাকে ফুঁসলিয়েছিল"],["عَن","ʿan","they demanded from him","সম্পর্কে"],["ضَيْفِهِۦ","ḍayfihi","his guests","তার মেহমান (দের)"],["فَطَمَسْنَآ","faṭamasnā","so We blinded","আমরা তখন নিষ্প্রভ করেছিলাম"],["أَعْيُنَهُمْ","aʿyunahum","their eyes","তাদের চোখগুলোকে"],["فَذُوقُوا۟","fadhūqū","So taste","\"তোমরা এখন স্বাদ নাও"],["عَذَابِى","ʿadhābī","My punishment","আমার শাস্তির"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্কবাণীর\""]],"٣٧"],[38,"আৰু নিশ্চয় পুৱা দোকমুকালিতে সিহঁতৰ ওপৰত বিৰামহীন শাস্তি নামি আহিছিল।","And there came upon them by morning an abiding punishment.",[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["صَبَّحَهُم","ṣabbaḥahum","seized them in the morning","তাদের উপর আপতিত হলো"],["بُكْرَةً","buk'ratan","early","খুব ভোরে"],["عَذَابٌۭ","ʿadhābun","a punishment","শাস্তি"],["مُّسْتَقِرٌّۭ","mus'taqirrun","abiding","বিরামহীন"]],"٣٨"],[39,"‘এতেকে মোৰ শাস্তি আৰু সাৱধানবাণীৰ পৰিণাম ভোগ কৰা’।","So taste My punishment and warning.",[["فَذُوقُوا۟","fadhūqū","So taste","তোমরা এখন স্বাদ নাও"],["عَذَابِى","ʿadhābī","My punishment","আমার শাস্তির"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্কবাণীর"]],"٣٩"],[40,"আৰু নিশ্চয় আমি কোৰআনক সহজ কৰি দিছোঁ উপদেশ গ্ৰহণ কৰাৰ বাবে; এতেকে কোনোবা উপদেশ গ্ৰহণকাৰী আছেনে?","And We have certainly made the Qur’ān easy for remembrance, so is there any who will remember?",[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["يَسَّرْنَا","yassarnā","We have made easy","আমরা সহজ করেছি"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআনকে"],["لِلذِّكْرِ","lildhik'ri","for remembrance","উপদেশ গ্রহণের জন্য"],["فَهَلْ","fahal","so is (there)","কি তবে (আছে)"],["مِن","min","any","কোনো"],["مُّدَّكِرٍۢ","muddakirin","who will receive admonition","উপদেশ গ্রহণকারী"]],"٤٠"],[41,"আৰু নিশ্চয় ফিৰআউন গোষ্ঠিৰ ওচৰতো সতৰ্ককাৰী আহিছিল;","And there certainly came to the people of Pharaoh warning.",[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["جَآءَ","jāa","came","এসেছিল"],["ءَالَ","āla","(to the) people","সম্প্রদায়ের (কাছে)"],["فِرْعَوْنَ","fir'ʿawna","(of) Firaun","ফিরআউনের"],["ٱلنُّذُرُ","l-nudhuru","warnings","সতর্ককারীরা"]],"٤١"],[42,"সিহঁতে আমাৰ সকলো নিদৰ্শনকে অস্বীকাৰ কৰিলে, এতেকে আমি মহাপৰাক্ৰমশালী আৰু সৰ্বশক্তিমানৰূপে সিহঁতক ধৰিলোঁ।","They denied Our signs, all of them, so We seized them with a seizure of one Exalted in Might and Perfect in Ability.",[["كَذَّبُوا۟","kadhabū","They denied","তারা মিথ্যা বলেছিল"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Signs","আমাদের নিদর্শনের"],["كُلِّهَا","kullihā","all of them","সবগুলোকেই"],["فَأَخَذْنَـٰهُمْ","fa-akhadhnāhum","so We seized them","ফলে তাদেরকে আমরা পাকড়াও করলাম"],["أَخْذَ","akhdha","(with) a seizure","পাকড়াও"],["عَزِيزٍۢ","ʿazīzin","(of) All-Mighty","পরাক্রমশালীর"],["مُّقْتَدِرٍ","muq'tadirin","(the) Powerful One","মহাশক্তিমানের"]],"٤٢"],[43,"তোমালোকৰ মাজৰ কাফিৰসকল সেইসকল কাফিৰতকৈ উত্তম নেকি? নে তোমালোকৰ বাবে পূৰ্বৱৰ্তী কিতাবত কোনো মুক্তিৰ ঘোষণা আছে?","Are your disbelievers better than those [former ones], or have you immunity in the scriptures?",[["أَكُفَّارُكُمْ","akuffārukum","Are your disbelievers","তোমাদের কাফিররা কি"],["خَيْرٌۭ","khayrun","better","উত্তম"],["مِّنْ","min","than","চেয়ে"],["أُو۟لَـٰٓئِكُمْ","ulāikum","those","ঐসব লোকদের"],["أَمْ","am","or","কিংবা"],["لَكُم","lakum","for you","তোমাদের জন্যে আছে"],["بَرَآءَةٌۭ","barāatun","(is) an exemption","(লিখিত) মুক্তির সনদ"],["فِى","fī","in","মধ্যে"],["ٱلزُّبُرِ","l-zuburi","the Scriptures","(পূর্বের) গ্রন্থসমূহের"]],"٤٣"],[44,"নে সিহঁতে কয়, ‘আমি সংঘবদ্ধ অপৰাজেয় দল’?","Or do they say, \"We are an assembly supporting [each other]\"?",[["أَمْ","am","Or","অথবা (কি)"],["يَقُولُونَ","yaqūlūna","(do) they say","তারা বলে"],["نَحْنُ","naḥnu","We","\"আমরা"],["جَمِيعٌۭ","jamīʿun","(are) an assembly","সংঘবদ্ধ দল"],["مُّنتَصِرٌۭ","muntaṣirun","helping (each other)","বিজয়ী\""]],"٤٤"],[45,"এই দল অনতিপলমে পৰাজিত হ’ব আৰু পিঠ দেখুৱাই পলায়ন কৰিব,","[Their] assembly will be defeated, and they will turn their backs [in retreat].",[["سَيُهْزَمُ","sayuh'zamu","Soon will be defeated","শীঘ্রই পরাজিত করা হবে"],["ٱلْجَمْعُ","l-jamʿu","(their) assembly","(এই) সংঘবদ্ধ দলকে"],["وَيُوَلُّونَ","wayuwallūna","and they will turn","এবং তারা ফিরাবে"],["ٱلدُّبُرَ","l-dubura","(their) backs","পিঠ"]],"٤٥"],[46,"বৰং কিয়ামত সিহঁতৰ শাস্তিৰ নিৰ্ধাৰিত সময়; আৰু কিয়ামত হৈছে অতি ভয়াৱহ আৰু তিক্তকৰ;","But the Hour is their appointment [for due punishment], and the Hour is more disastrous and more bitter.",[["بَلِ","bali","Nay","বরং"],["ٱلسَّاعَةُ","l-sāʿatu","the Hour","কিয়ামত"],["مَوْعِدُهُمْ","mawʿiduhum","(is) their promised time","তাদের নির্ধারিত সময় (বুঝাপড়ার)"],["وَٱلسَّاعَةُ","wal-sāʿatu","and the Hour","এবং কিয়ামত"],["أَدْهَىٰ","adhā","(will be) more grievous","বড়ই ভয়াবহ"],["وَأَمَرُّ","wa-amarru","and more bitter","ও বড়ই তিক্ত"]],"٤٦"],[47,"নিশ্চয় অপৰাধীসকল বিভ্ৰান্তি আৰু শাস্তিত আছে।","Indeed, the criminals are in error and madness..",[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","the criminals","অপরাধীরা (রয়েছে)"],["فِى","fī","(are) in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["وَسُعُرٍۢ","wasuʿurin","and madness","ও বিকৃতবুদ্ধির মধ্যে"]],"٤٧"],[48,"যিদিনা সিহঁতক নাক চোঁচৰাই টানি জাহান্নামত লৈ যোৱা হ’ব (সেই দিনা কোৱা হ’ব) ‘এতিয়া জাহান্নামৰ স্পৰ্শ ভোগ কৰা’।","The Day they are dragged into the Fire on their faces [it will be said], \"Taste the touch of Saqar.\"",[["يَوْمَ","yawma","(The) Day","যেদিন"],["يُسْحَبُونَ","yus'ḥabūna","they will be dragged","(তাদেরকে) টেনে নেওয়া হবে"],["فِى","fī","into","মধ্যে"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["عَلَىٰ","ʿalā","on","উপর"],["وُجُوهِهِمْ","wujūhihim","their faces","তাদের মুখের (ভর করে)"],["ذُوقُوا۟","dhūqū","Taste","\"(বলা হবে) স্বাদ নাও"],["مَسَّ","massa","(the) touch","স্পর্শের"],["سَقَرَ","saqara","(of) Hell","জাহান্নামের\""]],"٤٨"],[49,"নিশ্চয় আমি প্ৰতিটো বস্তু এটা নিৰ্ধাৰিত পৰিমাপত সৃষ্টি কৰিছোঁ।","Indeed, all things We created with predestination.",[["إِنَّا","innā","Indeed, [We]","নিশ্চয়ই আমরা"],["كُلَّ","kulla","every","প্রত্যেক"],["شَىْءٍ","shayin","thing","জিনিসকে"],["خَلَقْنَـٰهُ","khalaqnāhu","We created it","তা আমরা সৃষ্টি করেছি"],["بِقَدَرٍۢ","biqadarin","by a measure","নির্ধারিত পরিমাণ দিয়ে"]],"٤٩"],[50,"আৰু আমাৰ আদেশ কেৱল এটা কথাৰ দূৰত্ব, চকুৰ পলকৰ দৰে।","And Our command is but one, like a glance of the eye.",[["وَمَآ","wamā","And not","এবং না"],["أَمْرُنَآ","amrunā","(is) Our Command","আমাদের নির্দেশ (দেওয়া হয়)"],["إِلَّا","illā","but","এছাড়া যে"],["وَٰحِدَةٌۭ","wāḥidatun","one","একবারই"],["كَلَمْحٍۭ","kalamḥin","like the twinkling","পলকের মতো"],["بِٱلْبَصَرِ","bil-baṣari","(of) the eye","চোখের (তা কার্যকর হয়)"]],"٥٠"],[51,"আৰু আমি তোমালোকৰ দৰে বহুতকে ধ্বংস কৰিছোঁ; এতেকে উপদেশ গ্ৰহণকাৰী কোনোবা আছেনে?","And We have already destroyed your kinds, so is there any who will remember?",[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَهْلَكْنَآ","ahlaknā","We destroyed","আমরা ধ্বংস করেছি"],["أَشْيَاعَكُمْ","ashyāʿakum","your kinds","তোমাদের (মত) দলগুলোকে"],["فَهَلْ","fahal","so is (there)","কি তবে (আছে)"],["مِن","min","any","কোনো"],["مُّدَّكِرٍۢ","muddakirin","who will receive admonition","উপদেশগ্রহণকারী (এ হতে)"]],"٥١"],[52,"আৰু সিহঁতে যি কৰিছে, সেই সকলো ‘আমলনামাত’ (লিপিবদ্ধ) আছে,","And everything they did is in