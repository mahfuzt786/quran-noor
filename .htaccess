# Noor (Quran practice) — headers for this folder on Apache (smahfuzm.in/quran-noor/).
# The site-wide policy blocks the microphone, web share and media from other hosts, which this app needs.
# These lines replace those two headers for this folder only; everything not listed stays blocked.
<IfModule mod_headers.c>
  Header unset Content-Security-Policy
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: data: https://download.quranicaudio.com https://audio.qurancdn.com; connect-src 'self' data: blob: https://download.quranicaudio.com https://audio.qurancdn.com https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

  # microphone: recite & check, letter checks, voice recording · autoplay: verse-to-verse playback · web-share: sending a backup
  Header unset Permissions-Policy
  Header always unset Permissions-Policy
  Header always set Permissions-Policy "microphone=(self), autoplay=(self), web-share=(self), fullscreen=(self), screen-wake-lock=(self), camera=(), geolocation=(), payment=(), usb=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), publickey-credentials-get=(), xr-spatial-tracking=()"

  # the page and the service worker must be re-checked on every visit so updates arrive; versioned files (?v=) can be cached long
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header unset Cache-Control
    Header always set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
